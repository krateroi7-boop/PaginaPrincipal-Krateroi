# Copiar a .env.local.
#
# Vite sólo expone al cliente las variables con prefijo VITE_, y las
# escribe literales dentro del paquete que descarga el visitante: acá
# no va nada que deba mantenerse en secreto. Los tokens de Telegram y
# la clave de Gemini viven en backend/.env y no salen de ahí.
#
# Lo que sí va acá son los datos de contacto, que son públicos por
# definición: se centralizan para no repetirlos en el marcado ni
# dejarlos en el historial del repositorio.

VITE_API_BASE_URL=http://localhost:3000

# Sólo dígitos, con código de país y sin el signo +
VITE_WHATSAPP=
# Cómo se muestra en pantalla
VITE_WHATSAPP_VISIBLE=
VITE_CORREO=
# Texto con el que se abre WhatsApp desde los botones del sitio
VITE_MENSAJE_WHATSAPP=Hola, quiero conversar un proyecto.
