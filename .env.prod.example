# Variables del despliegue en VPS. Copiar a .env.prod y completar.
#
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# .env.prod está en .gitignore: no debe entrar al repositorio.

# Origen público del sitio, tal como lo escribe el visitante. Sin barra
# final. Es la ÚNICA variable que hay que tocar para pasar de una IP
# desnuda a un dominio con Cloudflare, porque de ella salen tres cosas a
# la vez: el origen que acepta CORS, la dirección que queda compilada
# dentro del paquete del frontend y si el backend emite HSTS.
#
# Como queda compilada, al cambiarla hay que RECONSTRUIR la imagen `web`,
# no basta con reiniciarla:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build web
#
#   sin dominio  : http://203.0.113.10
#   con dominio  : https://krateroi.com
PUBLIC_ORIGIN=http://localhost

# Puerto que publica la VPS. 80 salvo que algo más lo ocupe.
PUBLIC_PORT=80

# Credenciales del bot de Telegram (BotFather). Nunca llegan al navegador.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Clave de Google AI Studio para el asistente.
GEMINI_API_KEY=

# Postgres. La contraseña la usa el contenedor de la base y el backend.
POSTGRES_USER=krateroi
POSTGRES_PASSWORD=
POSTGRES_DB=krateroi

# Datos de contacto, públicos por definición. Quedan escritos dentro del
# paquete del sitio.
VITE_WHATSAPP=
VITE_WHATSAPP_VISIBLE=
VITE_CORREO=
VITE_MENSAJE_WHATSAPP=Hola, quiero conversar un proyecto.
