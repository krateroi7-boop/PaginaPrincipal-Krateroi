# Copiar a .env y completar. El backend falla al arrancar si falta alguna
# variable requerida (ver src/common/config/validation.schema.ts).

PORT=3000

# Dominio del frontend permitido por CORS. Sin comodines.
CORS_ORIGIN=http://localhost:5173

# Credenciales del bot de Telegram (BotFather). Nunca deben existir en el frontend.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Clave de Google AI Studio para el asistente del sitio. Tampoco debe
# existir en el frontend: el navegador habla con este backend, no con Gemini.
GEMINI_API_KEY=

# Redis, usado por el módulo de colas (docker-compose.yml lo expone en 6379).
# En producción basta con REDIS_URL (redis://... o rediss://... con TLS): si
# está presente, el host y el puerto de abajo dejan de ser necesarios.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# Postgres, usado por el módulo de base de datos (docker-compose.yml lo expone en 5432).
# En producción basta con DATABASE_URL (postgres://... con el sslmode que pida
# el proveedor): si está presente, las cinco variables de abajo sobran.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=krateroi
POSTGRES_PASSWORD=
POSTGRES_DB=krateroi
